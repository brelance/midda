# Optional overrides. From midda-backend/: set -a; . ./.env; set +a
# Spring Boot does not read this file automatically.
SERVER_PORT=8080
MYSQL_USER=midda
MYSQL_PASSWORD=local-development
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9096
ES_URL=http://127.0.0.1:9202
JWT_PRIVATE_KEY=file:./secrets/private.pem
JWT_PUBLIC_KEY=file:./secrets/public.pem

# Required for publishing Markdown to Aliyun OSS.
# Endpoint is a hostname, for example oss-cn-hangzhou.aliyuncs.com.
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_DOMAIN=

# Optional AI / RAG services. These are independent from the desktop LLM_* settings.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# CANAL_ENABLED=true
# CANAL_HOST=127.0.0.1
