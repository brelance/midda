{
  "name": "midda",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "import-jmdict": "tsx scripts/import-jmdict.ts",
    "prebuild": "mkdir -p resources && npm run prebuild:ocr",
    "prebuild:ocr": "node -e \"if(process.platform==='darwin'){require('child_process').execSync('swiftc electron/main/api/ocr/ocr_vision.swift -o resources/ocr_vision',{stdio:'inherit'})}else{console.log('Skipping OCR binary (macOS only)')}\"",
    "build": "tsc && vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "rebuild-native": "electron-builder install-app-deps",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/sharp": "^0.31.1",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.8.0",
    "dompurify": "^3.3.3",
    "dotenv": "^17.2.3",
    "edge-tts-universal": "^1.4.0",
    "epub": "^2.1.1",
    "file-type": "^21.0.0",
    "jszip": "^3.10.1",
    "node-unrar-js": "^2.0.2",
    "onnxruntime-node": "^1.24.3",
    "pdfjs-dist": "^5.5.207",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "say": "^0.16.0",
    "sharp": "^0.34.5",
    "undici": "^7.16.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@scriptin/jmdict-simplified-types": "^3.6.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.2.0",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.6",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "main": "dist-electron/main.js"
}
